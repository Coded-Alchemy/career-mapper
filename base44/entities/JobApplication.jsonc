{
  "name": "JobApplication",
  "type": "object",
  "properties": {
    "company": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "job_url": {
      "type": "string"
    },
    "date_applied": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "To Apply",
        "Applied",
        "Phone Screen",
        "Interview",
        "Final Round",
        "Offer",
        "Rejected",
        "Ghosted"
      ]
    },
    "salary_range": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "remote": {
      "type": "boolean",
      "default": false
    },
    "tech_stack": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contact_name": {
      "type": "string"
    },
    "contact_email": {
      "type": "string",
      "format": "email"
    },
    "notes": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "company",
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}