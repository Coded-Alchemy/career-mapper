{
  "name": "Interaction",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Call",
        "Email",
        "Interview",
        "Message",
        "Other"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "application_id",
    "type"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}