{
  "name": "Profile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "linkedin": {
      "type": "string"
    },
    "github": {
      "type": "string"
    },
    "resume_url": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}