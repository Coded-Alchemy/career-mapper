{
  "name": "InterviewPrep",
  "type": "object",
  "properties": {
    "company": {
      "type": "string"
    },
    "role_title": {
      "type": "string"
    },
    "job_description": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "role_summary": {
      "type": "string"
    },
    "likely_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "behavioral_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technical_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prep_plan": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions_to_ask": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date_created": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "company",
    "role_title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}